# NUDGE Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
SESSION_SECRET=dev-session-secret-change-in-production
ALLOWED_ORIGIN=http://localhost:5173

# LLM Providers (Optional - built-in deterministic simulator runs if no key provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=simulator  # Options: simulator, gemini, openai, anthropic

# Google Workspace Integration (Only required for GoogleWorld live demo)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SPREADSHEET_ID=

# Security & Policy Settings
MAX_STEPS_PER_RUN=15
STEP_TIMEOUT_SECONDS=30
RECIPIENT_ALLOWLIST_MODE=strict_invoice_sheet
ENABLE_HASH_CHAIN_AUDIT=True
